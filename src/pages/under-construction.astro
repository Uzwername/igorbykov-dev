---
import { OPENING_MEDIA_CLASS_NAME } from '@/constants/styles';
import Layout from '@/layouts/Layout.astro';
import LinkButton from '@/components/LinkButton.astro';
import ExternalLink from '@/components/ExternalLink.astro';
import cv from '@/data/cv.json';
// `?url` makes Vite emit the file with a hashed `/_astro/` name (Astro has no video component).
import underConstructionVideo from '@/assets/under-construction.mp4?url';
import type { CvData } from '@/types/cv';

const { profile } = cv as CvData;
---

<Layout title="Igor Bykov — Under construction" noIndex>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <video
      src={underConstructionVideo}
      width="720"
      height="720"
      autoplay
      muted
      loop
      playsinline
      aria-label="A site under construction"
      class={OPENING_MEDIA_CLASS_NAME}
    ></video>
    <h1 class="mt-8 text-2xl font-semibold">This site is under construction</h1>
    <p class="mt-1">
      Something great is being built here, so check back soon! In the meantime,
      feel free to have a look at{' '}
      <ExternalLink
        href={profile.contact.linkedin}
        rel={['me']}
        class="text-accent hover:text-accent-emphasis underline underline-offset-2 transition-colors"
      >
        my LinkedIn
      </ExternalLink>{' '}
      or drop me an email.
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <LinkButton href={`mailto:${profile.contact.email}`}>
        Send email
      </LinkButton>
    </div>
  </section>
</Layout>
