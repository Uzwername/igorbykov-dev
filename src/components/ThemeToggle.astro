---
import { Icon } from 'astro-icon/components';
import { THEME_TOGGLE_ID } from '@/constants/html';
import IconButton from '@/components/IconButton.astro';
---

<IconButton id={THEME_TOGGLE_ID} label="Toggle theme">
  <Icon
    name="mdi:white-balance-sunny"
    aria-hidden="true"
    class="hidden size-4 dark:block"
  />
  <Icon
    name="mdi:weather-night"
    aria-hidden="true"
    class="block size-4 dark:hidden"
  />
</IconButton>

<script>
  import { THEME_TOGGLE_ID } from '@/constants/html';
  import { THEME_DARK, THEME_LIGHT } from '@/constants/theme';
  import { getById } from '@/utils/html';
  import { persistTheme } from '@/utils/theme';

  (() => {
    const button = getById(THEME_TOGGLE_ID);

    button.addEventListener(
      'click',
      () => {
        const isDark = document.documentElement.classList.toggle(THEME_DARK);
        persistTheme(isDark ? THEME_DARK : THEME_LIGHT);
      },
      { passive: true },
    );
  })();
</script>
