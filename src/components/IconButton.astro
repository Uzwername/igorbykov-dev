---
import { ICON_BUTTON_CLASS_NAME } from '@/constants/styles';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'aria-label'> {
  label: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<button
  type="button"
  aria-label={label}
  class={[ICON_BUTTON_CLASS_NAME, className].filter(Boolean).join(' ')}
  {...rest}
>
  <slot />
</button>
