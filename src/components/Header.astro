---
import { NAV_BAR_PADDING_CLASS_NAME } from '@/constants/styles';
import MobileNav from '@/components/MobileNav.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import TopNavLogo from '@/components/TopNavLogo.astro';

const navItems = [
  { href: '/freelance', label: 'Freelance' },
  { href: '/projects', label: 'Projects' },
  { href: '/cv', label: 'CV' },
  { href: '/writing', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-border border-b">
  <div
    class={`mx-auto flex max-w-3xl items-center justify-between ${NAV_BAR_PADDING_CLASS_NAME}`}
  >
    <TopNavLogo />
    <div class="flex items-center gap-4">
      <ul class="hidden gap-6 text-sm md:flex">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-fg-muted hover:text-fg transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <MobileNav navItems={navItems} />
    </div>
  </div>
</header>
