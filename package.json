{
  "name": "igorbykov-dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Igor Bykov's personal site",
  "author": {
    "name": "Igor Bykov",
    "email": "igor.bykov@protonmail.com",
    "url": "https://igorbykov.dev/"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --fix",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:generate": "pnpm assets:generate:cv && pnpm assets:generate:meta",
    "assets:generate:cv": "tsx scripts/cv",
    "assets:generate:meta": "tsx scripts/favicon && tsx scripts/og-image"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astro-seo-schema": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.11",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "ghtml": "^4.0.2",
    "jsdom": "^30.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.0",
    "puppeteer-core": "^25.16.0",
    "schema-dts": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "4.151.3"
  }
}